<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Menu_Principal.uss?fileID=7433441132597879392&amp;guid=13883ab9596ca4e47bb17f6775a5c4be&amp;type=3#Menu_Principal" />
    <ui:VisualElement name="Background" style="flex-grow: 1; width: 100%; height: 100%; justify-content: flex-end; background-image: url(&quot;project://database/Assets/Images/Background_Juego.jpg?fileID=2800000&amp;guid=f8a2af5971dfc634787981c3c80a1189&amp;type=3#Background_Juego&quot;); -unity-background-scale-mode: stretch-to-fill; align-items: auto; align-self: flex-start; -unity-slice-type: sliced; background-size: 100% 100%; background-position-x: center; background-position-y: center; position: relative; background-color: rgba(8, 8, 8, 0);">
        <ui:VisualElement name="Cabecera" style="flex-grow: 1; background-size: 65% 65%; justify-content: flex-start; align-self: auto; width: 100%; height: 25%; background-image: url(&quot;project://database/Assets/Images/Titulo_Juego.png?fileID=2800000&amp;guid=7b5c8a5172662774bbf11c60642e1918&amp;type=3#Titulo_Juego&quot;); position: relative; right: auto; background-position-x: left 40%;" />
        <ui:VisualElement name="Cuerpo" style="flex-grow: 1; background-size: 100% 100%; justify-content: flex-start; align-self: auto; width: 100%; height: 75%; position: relative; display: flex;">
            <ui:Button text="Iniciar juego" name="PlayButton" class="boton botonMenu" />
            <ui:Button text="Ajustes" name="OptionButton" class="boton botonMenu" />
            <ui:Button text="Accesibilidad" name="AccessibilityButton" class="boton botonMenu" />
            <ui:Button text="Créditos" name="CreditsButton" class="boton botonMenu" />
            <ui:Button text="Salir" name="ExitButton" class="boton botonMenu" />
            <ui:VisualElement name="Logo" style="flex-grow: 1; width: 10%; height: 20%; position: absolute; top: auto; bottom: 5%; align-self: flex-end; background-image: url(&quot;project://database/Assets/Images/Logo_Color.png?fileID=2800000&amp;guid=ba942be858c47534fbdc71af1610d911&amp;type=3#Logo_Color&quot;); right: 50px;" />
            <ui:VisualElement name="Accesibilidad" style="flex-grow: 1; width: 60%; height: 98%; align-self: center; align-content: auto; justify-content: flex-start; align-items: auto; position: absolute; background-color: rgb(85, 71, 89); border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; border-left-color: rgb(62, 45, 66); border-right-color: rgb(62, 45, 66); border-top-color: rgb(62, 45, 66); border-bottom-color: rgb(62, 45, 66); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; right: auto; top: auto; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; left: auto; display: flex; visibility: hidden;">
                <ui:Label text="Accesibilidad" name="Titulo" style="font-size: 60px; -unity-font-style: bold; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 30px; color: rgb(217, 171, 63); top: 3%; position: absolute; align-self: center; -unity-font-definition: url(&quot;project://database/Assets/Fonts/BAHNSCHRIFT.TTF?fileID=12800000&amp;guid=35ed3b0f5e1f70b46b814584f8854fd0&amp;type=3#BAHNSCHRIFT&quot;);" />
                <ui:Button text="x" name="CerrarButton" class="botonCerrar" style="align-self: center; justify-content: center; align-items: center; align-content: center; right: 10px; position: absolute; top: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; -unity-font-style: bold; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: 60px; height: 60px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/BAHNSCHRIFT.TTF?fileID=12800000&amp;guid=35ed3b0f5e1f70b46b814584f8854fd0&amp;type=3#BAHNSCHRIFT&quot;); scale: 1 1;" />
                <ui:VisualElement name="Recuadro" style="flex-grow: 1; width: 90%; height: 70%; position: absolute; left: 5%; align-self: center; align-content: auto; justify-content: flex-start; align-items: auto; top: 20%; background-color: rgb(104, 88, 96); border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; border-left-color: rgb(62, 45, 66); border-right-color: rgb(62, 45, 66); border-top-color: rgb(62, 45, 66); border-bottom-color: rgb(62, 45, 66); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; display: flex;">
                    <ui:Toggle toggle-on-label-click="false" focusable="true" value="false" language-direction="Inherit" name="CambiarContraste" label="Cambiar contraste  " style="font-size: 50px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 30px; margin-left: 0; width: 100%; color: rgb(217, 171, 63); position: relative; align-items: center; align-content: auto; justify-content: flex-start; align-self: flex-start; top: auto; left: auto; -unity-font-definition: url(&quot;project://database/Assets/Fonts/BAHNSCHRIFT.TTF?fileID=12800000&amp;guid=35ed3b0f5e1f70b46b814584f8854fd0&amp;type=3#BAHNSCHRIFT&quot;); height: 50%;" />
                    <ui:VisualElement name="CambiarTamano" style="flex-grow: 1; width: 100%; height: 50px; flex-direction: row; align-items: center;">
                        <ui:Label text="Tamaño de fuente" name="TamanoFuenteTexto" style="font-size: 50px; width: auto; height: auto; align-items: auto; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 30px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/BAHNSCHRIFT.TTF?fileID=12800000&amp;guid=35ed3b0f5e1f70b46b814584f8854fd0&amp;type=3#BAHNSCHRIFT&quot;); color: rgb(217, 171, 63); white-space: nowrap; flex-direction: row; align-content: auto; justify-content: space-evenly;" />
                        <ui:Button text="-" name="ReducirTamanoFuente" style="flex-direction: row; width: auto; height: auto; align-self: center; align-items: center; font-size: 40px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/BAHNSCHRIFT.TTF?fileID=12800000&amp;guid=35ed3b0f5e1f70b46b814584f8854fd0&amp;type=3#BAHNSCHRIFT&quot;); margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;" />
                        <ui:Button text="+" name="AumentarTamanoFuente" style="flex-direction: row; -unity-font-definition: url(&quot;project://database/Assets/Fonts/BAHNSCHRIFT.TTF?fileID=12800000&amp;guid=35ed3b0f5e1f70b46b814584f8854fd0&amp;type=3#BAHNSCHRIFT&quot;); font-size: 40px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
