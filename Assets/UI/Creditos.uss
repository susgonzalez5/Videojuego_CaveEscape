:root {
}

.backButton {
    background-image: url("project://database/Assets/Images/HomeButton.png?fileID=2800000&guid=f3e494416ea83f64b8f391839956ee56&type=3#HomeButton");
    visibility: visible;
    display: flex;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.backButton:hover {
    background-image: url("project://database/Assets/Images/HomeButtonHover.png?fileID=2800000&guid=733e3fcfba9046641822993b6565349c&type=3#HomeButtonHover");
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.playAudioButton {
    background-image: url('project://database/Assets/Images/Play.png?fileID=2800000&guid=d5105d3aa20bb694d96cac3661ce083d&type=3#Play');
    background-size: 80% 80%;
}

.playAudioButton:hover {
    background-image: url("project://database/Assets/Images/PlayButton.png?fileID=2800000&guid=018d361a807bc32458d13ac821ce5d9a&type=3#PlayButton");
    background-size: 95% 95%;
}
